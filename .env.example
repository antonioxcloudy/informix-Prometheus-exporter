# Linux Informix runtime archive. Keep it outside Git and image layers.
INFORMIX_CSDK_ARCHIVE=./runtime/informix-client-runtime-linux-amd64.tar.gz

EXPORTER_VERSION=dev
EXPORTER_COMMIT=unknown
EXPORTER_BUILD_DATE=unknown
EXPORTER_PLATFORM=linux/amd64
# Listen on every interface so the monitoring server is reachable remotely.
# Use 127.0.0.1 when access is only local or goes through a local reverse proxy.
MONITORING_BIND_ADDRESS=0.0.0.0
EXPORTER_PORT=8080
EXPORTER_SCRAPE_TIMEOUT=8s
EXPORTER_SLOW_REFRESH_INTERVAL=2h
# On Linux, set these to the owner of deploy/config (usually `id -u`/`id -g`).
EXPORTER_UID=65532
EXPORTER_GID=65532

PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=15d

ALERTMANAGER_PORT=9093
ALERTMANAGER_RETENTION=120h
# Used only with compose.webhook.yaml.
ALERTMANAGER_WEBHOOK_URL_FILE=./deploy/secrets/alertmanager_webhook_url

GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
